// niri config for the desk host.
//
// Rendered into ~/.config/niri/config.kdl by home/desktop.nix.
// Design: docs/desktop-migration.md, "The desktop session".

// ---------------------------------------------------------------------------
// GPU pinning — enabled 2026-09-24.
//
// The plan's end state is that niri renders on the iGPU and never opens the
// dGPU, even while the dGPU is lent to the host. A compositor that holds a
// card's DRM node pins it, and the card cannot go back to vfio-pci until the
// compositor exits — so without this, starting the VM would mean logging out.
//
// Enabled once the monitor cable moved to the motherboard and the first boot
// into desk read boot_vga=1 on the iGPU (0000:12:00.0). If the display cable
// ever goes back to the dGPU, comment this out first: niri would render on a
// GPU driving no screen and ignore the one that has the monitor, which gives a
// black session (recover from another tty, SSH, or the previous generation
// in the boot menu).
//
// Both are `debug` options — check them against the niri wiki for the pinned
// version.
//
// Verified at runtime on the 2026-09-24 reboot, and this is the Phase 4 gate:
//
//     attempting to use render node from config: ".../pci-0000:12:00.0-render"
//     using as the render node: "/dev/dri/renderD129"
//     adding device: 57858 "/dev/dri/card2"   <- this is the primary node
//     adding device: 57857 "/dev/dri/card1"
//     node is ignored, skipping               <- the dGPU, never opened
//
// and niri's only DRM file descriptors were card2. So `ignore-drm-device`
// *does* accept a by-path symlink, and no udev rule is needed — an earlier
// note here guessed one might be. Key any future rule off the PCI address
// anyway, not the node number: the numbering is the reverse of what this
// comment first assumed. dGPU 03:00.0 is renderD128 and iGPU 12:00.0 is
// renderD129, not the other way round.
debug {
    render-drm-device "/dev/dri/by-path/pci-0000:12:00.0-render"
    ignore-drm-device "/dev/dri/by-path/pci-0000:03:00.0-render"
}
// ---------------------------------------------------------------------------

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        natural-scroll
    }

    // Focus follows the click, not the pointer. `focus-follows-mouse` is a
    // presence flag in niri's KDL, not a boolean — it takes no argument, and
    // off is simply the absence of the node. `focus-follows-mouse off` is a
    // parse error, which is fatal: niri.service exits before it ever opens a
    // DRM device.
}

// The display is a 3440x1440 ultrawide (Phase 0 read the modes off it).
// Left unconfigured deliberately: niri picks the preferred mode, and hard-
// coding a connector name here would break when the cable moves from the
// dGPU's HDMI-A-1 to an iGPU output.

layout {
    gaps 8
    // Workspaces are drawn over the backdrop, where the wallpaper lives (see
    // the layer-rule below); a transparent workspace lets it show through.
    background-color "transparent"
    center-focused-column "never"

    // Just the two, so Mod+W's switch-preset-column-width toggles between them.
    preset-column-widths {
        proportion 0.25
        proportion 0.5
    }

    default-column-width { proportion 0.25; }

    focus-ring {
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
}

// App-key windows (Mod+1, … below) open at the quarter-width default, except
// Claude Code at half. Mod+W still toggles the width from there.
window-rule {
    match app-id=r#"^chrome-claude\.ai__code-Default$"#
    default-column-width { proportion 0.5; }
}

// No bar, and no spawn-at-startup for the shell. Quickshell (the panel,
// notifications and pop-ups — home/quickshell/) is a user unit WantedBy
// graphical-session.target, which niri raises. A spawn line here as well
// would make two launchers race for org.freedesktop.Notifications, which is
// what left swaync.service failed on 2026-09-24.

// niri has no built-in Xwayland; this starts it on demand. Steam needs it.
spawn-at-startup "xwayland-satellite"

environment {
    DISPLAY ":0"
}

prefer-no-csd

// The macOS cursor theme, installed by home/desktop.nix (home.pointerCursor).
// niri draws the pointer itself and passes these on to apps it spawns as
// XCURSOR_THEME/XCURSOR_SIZE. Keep them in step with home.pointerCursor.
cursor {
    xcursor-theme "macOS"
    xcursor-size 24
}

// Quickshell's wallpaper (quickshell/Wallpaper.qml) goes in the backdrop, so
// it also shows behind the workspaces in the overview. The backdrop is only
// visible on the desktop because layout's background-color is transparent.
layer-rule {
    match namespace="^quickshell-wallpaper$"
    place-within-backdrop true
}

screenshot-path "~/screenshots/%Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 0.6
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Terminal" { spawn "xdg-terminal-exec"; }
    Mod+D hotkey-overlay-title="Launcher" { spawn "qs" "-c" "desk" "ipc" "call" "launcher" "toggle"; }
    Mod+Shift+N hotkey-overlay-title="Notifications and status" { spawn "qs" "-c" "desk" "ipc" "call" "panel" "toggle"; }
    // Pick a worktree of ~/natb1/nix-config (main first), then pull and
    // switch to it in a terminal — hosts/desk/rebuild-menu.nix.
    Mod+Shift+R hotkey-overlay-title="Rebuild (pick worktree, pull + switch)" { spawn "rebuild-menu"; }

    Mod+Q { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }

    // App keys: focus the app's window wherever it is, or open it at the
    // given column — hosts/desk/focus-or-launch.nix. The second argument is
    // the window's app_id; keep it in step with the window rules above.
    Mod+1 hotkey-overlay-title="Cadence" { spawn "focus-or-launch" "1" "chrome-claude.ai__artifact_54sxzR169AZiUx8QNJkngJ-Default" "google-chrome-stable" "--app=https://claude.ai/artifact/54sxzR169AZiUx8QNJkngJ"; }
    Mod+2 hotkey-overlay-title="Claude Code" { spawn "focus-or-launch" "2" "chrome-claude.ai__code-Default" "google-chrome-stable" "--app=https://claude.ai/code"; }
    // Default is the nathan@natb1.com profile; naming it skips the profile picker.
    Mod+3 hotkey-overlay-title="Google Chrome" { spawn "focus-or-launch" "3" "google-chrome" "google-chrome-stable" "--profile-directory=Default"; }

    // Workspaces moved off Mod+N to make room for the app keys.
    Mod+Alt+1 { focus-workspace 1; }
    Mod+Alt+2 { focus-workspace 2; }
    Mod+Alt+3 { focus-workspace 3; }
    Mod+Alt+4 { focus-workspace 4; }
    Mod+Alt+5 { focus-workspace 5; }

    Mod+W hotkey-overlay-title="Toggle width ½ / ¼" { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    // No screen locker by design, so this is the only way out of the session.
    Mod+Shift+E { quit; }
    // Suspend / reboot (into the boot menu, firmware setup, Windows, MemTest)
    // / power off / log out — hosts/desk/power-menu.nix.
    Mod+Shift+Escape hotkey-overlay-title="Power menu" { spawn "power-menu"; }
}
