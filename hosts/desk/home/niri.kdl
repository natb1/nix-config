// niri config for the desk host.
//
// Rendered into ~/.config/niri/config.kdl by home/desktop.nix.
// Design: docs/desktop-migration.md, "The desktop session".

// ---------------------------------------------------------------------------
// GPU pinning — enabled 2026-09-24.
//
// The plan's end state is that niri renders on the iGPU and never opens the
// dGPU, even while the dGPU is lent to the host. A compositor that holds a
// card's DRM node pins it, and the card cannot go back to vfio-pci until the
// compositor exits — so without this, starting the VM would mean logging out.
//
// Enabled once the monitor cable moved to the motherboard and the first boot
// into desk read boot_vga=1 on the iGPU (0000:12:00.0). If the display cable
// ever goes back to the dGPU, comment this out first: niri would render on a
// GPU driving no screen and ignore the one that has the monitor, which gives a
// black session (recover from another tty, SSH, or the previous generation
// in the boot menu).
//
// Both are `debug` options — check them against the niri wiki for the pinned
// version. If `ignore-drm-device` will not take a by-path symlink, use the
// node the dGPU gets when lent (/dev/dri/renderD129-shaped) plus a udev rule
// to make the name stable.
debug {
    render-drm-device "/dev/dri/by-path/pci-0000:12:00.0-render"
    ignore-drm-device "/dev/dri/by-path/pci-0000:03:00.0-render"
}
// ---------------------------------------------------------------------------

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        natural-scroll
    }

    // Focus follows the click, not the pointer.
    focus-follows-mouse off
}

// The display is a 3440x1440 ultrawide (Phase 0 read the modes off it).
// Left unconfigured deliberately: niri picks the preferred mode, and hard-
// coding a connector name here would break when the cable moves from the
// dGPU's HDMI-A-1 to an iGPU output.

layout {
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
}

spawn-at-startup "waybar"
spawn-at-startup "swaync"

// niri has no built-in Xwayland; this starts it on demand. Steam needs it.
spawn-at-startup "xwayland-satellite"

environment {
    DISPLAY ":0"
}

prefer-no-csd

screenshot-path "~/screenshots/%Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 0.6
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Terminal" { spawn "wezterm"; }
    Mod+D hotkey-overlay-title="Launcher" { spawn "fuzzel"; }
    Mod+Shift+N hotkey-overlay-title="Notifications" { spawn "swaync-client" "-t" "-sw"; }

    Mod+Q { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }

    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    // No screen locker by design, so this is the only way out of the session.
    Mod+Shift+E { quit; }
}
