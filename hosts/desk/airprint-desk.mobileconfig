<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Adds desk's Brother queue (hosts/desk/printing.nix) to an iPhone or iPad by
  address. The queue is tailnet-only and unadvertised, and iOS has no settings
  screen for adding a printer by address — but it accepts this payload from a
  hand-installed profile (com.apple.airprint: supervised false,
  allowmanualinstall true). AirDrop it to the phone, then Settings → Profile
  Downloaded → Install. Printing needs the Tailscale VPN on.

  `desk` is the MagicDNS short name, the same one Files resolves for
  smb://desk/media. No TLS: the path is already WireGuard.

  Also a home-screen Web Clip, "desk media", opening smb://n8@desk. iOS has no
  payload for Files' server list (Apple's payload reference, 2026-09-25), but
  an smb:// URL hands off to Files' Connect to Server. It lands at the server,
  not in `media` (iOS drops the share path), and asks for the Samba password
  the first time — which never goes in a profile: this repo is public.
  Unverified as a Web Clip until tried; the fallback is Files → ⋯ → Connect
  to Server by hand.
-->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>AirPrint</key>
			<array>
				<dict>
					<key>IPAddress</key>
					<string>desk</string>
					<key>ResourcePath</key>
					<string>printers/brother</string>
					<key>Port</key>
					<integer>631</integer>
					<key>ForceTLS</key>
					<false/>
				</dict>
			</array>
			<key>PayloadDisplayName</key>
			<string>Brother on desk</string>
			<key>PayloadIdentifier</key>
			<string>com.natb1.desk.airprint.brother</string>
			<key>PayloadType</key>
			<string>com.apple.airprint</string>
			<key>PayloadUUID</key>
			<string>66607332-E0AB-4ACF-9646-861C966F1C4E</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
		<dict>
			<key>URL</key>
			<string>smb://n8@desk</string>
			<key>Label</key>
			<string>desk media</string>
			<key>IsRemovable</key>
			<true/>
			<key>FullScreen</key>
			<false/>
			<key>PayloadDisplayName</key>
			<string>desk media share</string>
			<key>PayloadIdentifier</key>
			<string>com.natb1.desk.webclip.media</string>
			<key>PayloadType</key>
			<string>com.apple.webClip.managed</string>
			<key>PayloadUUID</key>
			<string>69AFCAFE-157A-49C6-96B0-67A2A1B00B39</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>The Brother HL-L2305 and the media share, both on desk over Tailscale.</string>
	<key>PayloadDisplayName</key>
	<string>desk (AirPrint + media share)</string>
	<key>PayloadIdentifier</key>
	<string>com.natb1.desk.airprint</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>A23E23EF-914F-4DF4-91BC-0A6A19F43F63</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
